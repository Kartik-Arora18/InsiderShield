APP_NAME=InsiderShield
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
POSTGRES_DB=insidershield
POSTGRES_USER=insidershield_app
POSTGRES_PASSWORD=change_this_local_dev_password
DATABASE_URL=postgresql+asyncpg://insidershield_app:change_this_local_dev_password@db:5432/insidershield
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
